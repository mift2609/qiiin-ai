# Contoh environment gateway. Salin ke /etc/qiiin-ai/gateway.env dengan mode 0600.
# Jangan commit token asli.
QIIIN_AUTH_TOKEN=GANTI_DENGAN_TOKEN_ACAK
QIIIN_BIND=127.0.0.1:8080
QIIIN_LLAMA_BASE=http://127.0.0.1:8081
QIIIN_STATUS_FILE=/var/run/qiiin-ai/system.json
QIIIN_WWW_DIR=/opt/qiiin-ai/www
QIIIN_SEARCH_PROVIDER=gnews
QIIIN_SEARCH_API_KEY=
QIIIN_KB_PATH=/opt/qiiin-ai/knowledge.db
