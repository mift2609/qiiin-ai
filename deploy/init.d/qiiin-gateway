#!/bin/sh /etc/rc.common
# QIIIN AI — Rust Axum API gateway (procd)
USE_PROCD=1
START=96
STOP=9

ENVFILE=/etc/qiiin-ai/gateway.env

start_service() {
	[ -f "$ENVFILE" ] || {
		logger -t qiiin-gateway "missing $ENVFILE"
		return 1
	}
	. "$ENVFILE"

	[ -x /opt/qiiin-ai/bin/qiiin-ai-gateway ] || {
		logger -t qiiin-gateway "gateway binary not found"
		return 1
	}

	procd_open_instance
	procd_set_param command /opt/qiiin-ai/bin/qiiin-ai-gateway
	procd_set_param env \
		QIIIN_BIND="${QIIIN_BIND:-127.0.0.1:8080}" \
		QIIIN_LLAMA_BASE="${QIIIN_LLAMA_BASE:-http://127.0.0.1:8081}" \
		QIIIN_STATUS_FILE="${QIIIN_STATUS_FILE:-/var/run/qiiin-ai/system.json}" \
		QIIIN_AUTH_TOKEN="$QIIIN_AUTH_TOKEN"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
